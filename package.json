{
  "name": "botornot",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @botornot/server --filter @botornot/web dev",
    "sim": "pnpm --filter @botornot/server sim",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter '!@botornot/contracts' typecheck",
    "test": "pnpm -r --filter '!@botornot/contracts' test",
    "test:contracts": "pnpm --filter @botornot/contracts test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
