# Copy to apps/server/.env and fill in. Never commit .env (the repo is public).

PORT=8787
# Origin of the web app, for the WebSocket origin check.
WEB_ORIGIN=http://localhost:3000

# LLM for the bots: "anthropic" or "mock" (canned replies, no key needed).
# Defaults to "anthropic" when ANTHROPIC_API_KEY is set, otherwise "mock".
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Bot model. claude-opus-5-5 (default) or claude-haiku-4-5 for lower cost and latency.
BOT_MODEL=claude-opus-5-5
# Model that screens messages going into and out of the bots (small and fast).
MODERATION_MODEL=claude-haiku-4-5
# Headlines the bots have "seen today" (RSS). Set to off to disable.
HEADLINES_RSS_URL=

# Testnet-only operator key that signs commitment receipts and, on-chain, settles rounds.
# Leave empty in development: a throwaway key is generated at startup.
OPERATOR_PRIVATE_KEY=

# On-chain mode (Base Sepolia). pnpm deploy:testnet fills in GAME_VAULT_ADDRESS; leave it empty to
# play for off-chain points instead.
GAME_VAULT_ADDRESS=
# Defaults to the public Base Sepolia endpoint.
RPC_URL=
# Coinbase Developer Platform paymaster URL (Base Sepolia). Players' wallets call it directly, so it
# isn't secret; the paymaster's contract allowlist limits what it pays for.
PAYMASTER_URL=

# Dev mode: players on one machine (browser windows, sim players) can match each other, and a
# player who runs out of points is topped back up. Default: on unless NODE_ENV=production, and the
# server refuses to start with DEV_MODE=true in production.
DEV_MODE=
# Share of matches given to a bot (0 to 1). Set to 0 to test human-vs-human with two windows.
BOT_SHARE=0.5
# SQLite file for points, payout pools and stats (relative to apps/server). Delete it to reset.
DB_PATH=data/botornot.db

# Length of a payout pool in ms (default 600000 = 10 minutes). Try 60000 to see pools settle quickly.
EPOCH_MS=

# Model the simulated players (pnpm sim) use. Cheap and fast by default.
SIM_MODEL=claude-haiku-4-5
# Model the AI judges use in the judge experiment (pnpm --filter @botornot/server judge-experiment).
JUDGE_MODEL=claude-opus-5-5
