# Copy to apps/web/.env.local. Never commit it.
# The game server's WebSocket. Hosted: wss://<server address>/ws
NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:8787/ws
# Optional: Base Sepolia RPC the browser reads token balances from (default: public endpoint).
NEXT_PUBLIC_RPC_URL=
# Optional: sign-in with an email code or Google, Apple or X (Coinbase embedded wallets).
# The Project ID from https://portal.cdp.coinbase.com; the project must list this site's address
# (http://localhost:3000 locally) under its allowed domains. Not secret. Empty: Base Account only.
NEXT_PUBLIC_CDP_PROJECT_ID=
